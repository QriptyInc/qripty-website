---
export interface Props {
  title?: string;
  description?: string;
  // Private pages (e.g. /report, whose link carries a secret token): keep them
  // out of search results and don't send the URL as a Referer to other sites.
  noindex?: boolean;
}
const {
  title = "Qripty — Quantum Readiness Platform for Fintech APIs",
  description = "Qripty discovers cryptographic exposure across your API estate, builds a live inventory, and deploys quantum-ready protection — no code changes, no data movement.",
  noindex = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {noindex && <meta name="referrer" content="no-referrer" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
<style is:global>

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary: #6B7CFF;
    --primary-dark: #4F5FE8;
    --secondary: #8B5CF6;
    --success: #00D4A1;
    --warn: #F59E0B;
    --bg: #FAFBFD;
    --surface: #FFFFFF;
    --text: #111827;
    --muted: #6B7280;
    --border: #E5E7EB;
    --border-light: #F3F4F6;
    --radius-sm: 10px;
    --radius: 16px;
    --radius-lg: 24px;
    --radius-xl: 32px;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --shadow: 0 4px 16px rgba(0,0,0,0.06), 0 2px 6px rgba(0,0,0,0.04);
    --shadow-md: 0 8px 32px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.10), 0 6px 18px rgba(0,0,0,0.05);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  a { color: inherit; }
  ul { list-style: none; }
  .mono { font-family: 'JetBrains Mono', monospace; }

  /* ── BRAND (logomark = ours, wordmark = client's exact artwork) ── */
  .logomark {
    width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    display: flex; align-items: center; justify-content: center;
  }
  .logomark svg { width: 19px; height: 19px; display: block; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img.wordmark { height: 21px; width: auto; display: block; }
  footer .brand img.wordmark { height: 23px; }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; height: 64px;
    background: rgba(250,251,253,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(229,231,235,0.6);
    transition: box-shadow 0.3s ease, height 0.3s ease, background 0.3s ease;
  }
  nav.scrolled { height: 56px; background: rgba(250,251,253,0.94); box-shadow: 0 1px 20px rgba(0,0,0,0.08); }
  .nav-links { display: flex; gap: 32px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--text); }
  .nav-actions { display: flex; gap: 12px; align-items: center; }
  .btn-ghost { font-size: 14px; font-weight: 500; color: var(--muted); text-decoration: none; padding: 8px 16px; border-radius: var(--radius-sm); transition: all 0.2s; }
  .btn-ghost:hover { color: var(--text); background: var(--border-light); }
  .btn-primary, .btn-hero-primary, .pricing-cta.solid {
    font-size: 14px; font-weight: 600; color: #fff; text-decoration: none;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    transition: all 0.2s; border: none; cursor: pointer;
  }
  .btn-primary { padding: 9px 20px; box-shadow: 0 2px 8px rgba(107,124,255,0.3); }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(107,124,255,0.4); }

  /* ── HERO ── */
  .hero {
    padding: 128px 40px 96px;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(0,1fr);
    gap: 24px;
    align-items: center;
    max-width: 1320px; margin: 0 auto;
  }
  .hero::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 780px;
    background: radial-gradient(ellipse 70% 55% at 30% 10%, rgba(107,124,255,0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-copy { text-align: left; position: relative; z-index: 1; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600;
    color: var(--primary);
    background: rgba(107,124,255,0.08);
    border: 1px solid rgba(107,124,255,0.2);
    padding: 6px 14px; border-radius: 100px;
    margin-bottom: 22px;
    letter-spacing: 0.01em;
  }
  .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--primary); display: inline-block; }
  .hero h1 {
    font-family: 'Inter Tight', sans-serif;
    font-size: clamp(32px, 3.4vw, 50px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--text);
    max-width: 560px; margin: 0 0 18px;
  }
  .hero h1 em { font-style: normal; color: var(--primary); }
  .hero-sub {
    font-size: 16.5px; color: var(--muted); max-width: 480px; margin: 0 0 30px;
    line-height: 1.7;
  }
  .hero-ctas { display: flex; gap: 12px; justify-content: flex-start; flex-wrap: wrap; margin-bottom: 18px; }
  .btn-hero-primary {
    font-size: 15px; padding: 14px 28px;
    box-shadow: 0 4px 20px rgba(107,124,255,0.35);
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
  }
  .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(107,124,255,0.45); }
  .btn-hero-secondary {
    font-size: 15px; font-weight: 600; color: var(--text); text-decoration: none;
    padding: 14px 28px; border-radius: var(--radius-sm);
    background: var(--surface); border: 1.5px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-hero-secondary:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }
  .hero-trust {
    display: flex; gap: 20px; justify-content: flex-start; flex-wrap: wrap;
    font-size: 12.5px; font-weight: 500; color: var(--muted);
    margin-bottom: 4px;
  }
  .hero-trust span { display: flex; align-items: center; gap: 6px; }
  .hero-trust span::before { content: '✓'; color: var(--success); font-weight: 700; }

  /* ── QUANTUM HERO VISUAL (the centerpiece) ── */
  .quantum-hero {
    position: relative;
    z-index: 1;
    padding: 8px 8px 0;
    perspective: 900px;
  }
  .qbit-field { position: absolute; inset: 0; pointer-events: none; }
  .qbit-label {
    position: absolute;
    font-size: 12px; font-weight: 500; color: var(--primary);
    opacity: 0; letter-spacing: 0.02em;
    animation: qbitDrift 8s ease-in-out infinite;
  }
  .qbit-label.alt { color: var(--secondary); }
  @keyframes qbitDrift {
    0%, 100% { opacity: 0; transform: translateY(6px); }
    15%, 75% { opacity: 0.32; transform: translateY(-4px); }
  }

  .scan-stage {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }
  .scan-glow {
    position: absolute; inset: -60px; border-radius: 50%;
    background: radial-gradient(circle, rgba(107,124,255,0.16) 0%, rgba(139,92,246,0.06) 45%, transparent 72%);
    filter: blur(6px);
    animation: glowPulse 5s ease-in-out infinite;
  }
  @keyframes glowPulse { 0%,100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.05); } }

  .scan-ring { position: absolute; inset: 0; border-radius: 50%; border: 2px dashed rgba(107,124,255,0.26); }
  .scan-ring.dots { border: none; box-shadow: 0 0 0 1.5px transparent; border: 1.5px dotted rgba(139,92,246,0.35); inset: -22px; }
  .scan-ring.r2 { inset: 62px; border-color: rgba(139,92,246,0.32); border-style: solid; }
  .scan-ring.r3 { inset: 146px; border: 2px dashed rgba(107,124,255,0.22); }
  .scan-spin { animation: spin 24s linear infinite; }
  .scan-spin-rev { animation: spin-rev 34s linear infinite; }
  .scan-spin-slow { animation: spin 90s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spin-rev { to { transform: rotate(-360deg); } }

  .scan-sweep {
    position: absolute; inset: 62px; border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(107,124,255,0) 0deg, rgba(107,124,255,0.4) 26deg, rgba(139,92,246,0.15) 50deg, rgba(107,124,255,0) 74deg);
    animation: spin 4s linear infinite;
  }

  /* orbiting qubit particles */
  .qubit-orbit { position: absolute; inset: 0; border-radius: 50%; animation: spin 10s linear infinite; }
  .qubit-orbit.o2 { inset: 62px; animation-duration: 16s; animation-direction: reverse; }
  .qubit-orbit.o3 { inset: 146px; animation-duration: 7s; }
  .qubit {
    position: absolute; top: -4px; left: 50%; margin-left: -4px;
    width: 8px; height: 8px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--primary) 60%);
    box-shadow: 0 0 8px rgba(107,124,255,0.75), 0 0 2px #fff;
  }
  .qubit.s { width: 6px; height: 6px; margin-left: -3px; background: radial-gradient(circle at 35% 30%, #fff, var(--secondary) 60%); box-shadow: 0 0 8px rgba(139,92,246,0.75); }

  /* data particles converging toward the core */
  .data-particle { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
  .data-particle .dot {
    position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%;
    background: var(--success); box-shadow: 0 0 6px rgba(0,212,161,0.7);
    animation: converge 3.6s ease-in infinite;
  }
  @keyframes converge {
    0% { transform: translateY(-255px) scale(0.5); opacity: 0; }
    12% { opacity: 1; }
    85% { opacity: 0.9; }
    100% { transform: translateY(-26px) scale(0.35); opacity: 0; }
  }

  .scan-core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: 104px; height: 104px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 10px rgba(107,124,255,0.08), var(--shadow-md);
    animation: pulse 3.2s ease-in-out infinite;
  }
  .scan-core svg { width: 40px; height: 40px; position: relative; z-index: 1; }
  .scan-core::after {
    content: ''; position: absolute; inset: -10px; border-radius: 50%;
    border: 2px dashed rgba(255,255,255,0.5);
    animation: spin 5s linear infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 10px rgba(107,124,255,0.08), var(--shadow-md); }
    50% { box-shadow: 0 0 0 18px rgba(107,124,255,0.14), var(--shadow-md); }
  }

  .scan-tag {
    position: absolute;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11.5px; font-weight: 700;
    padding: 5px 10px 5px 8px; border-radius: 8px;
    background: var(--surface); border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
    opacity: 0;
    animation: tagshow 8.5s ease-in-out infinite;
  }
  .scan-tag svg { width: 12px; height: 12px; flex-shrink: 0; }
  .scan-tag.safe { color: #059669; border-color: rgba(0,212,161,0.3); }
  .scan-tag.risk { color: #B45309; border-color: rgba(245,158,11,0.35); }
  .scan-tag.t1 { top: 2%; left: 50%; margin-left: -50px; animation-delay: 0s; }
  .scan-tag.t2 { top: 22%; right: -4%; animation-delay: 1.7s; }
  .scan-tag.t3 { bottom: 16%; right: 0%; animation-delay: 3.4s; }
  .scan-tag.t4 { bottom: 0%; left: 50%; margin-left: -42px; animation-delay: 5.1s; }
  .scan-tag.t5 { top: 24%; left: -6%; animation-delay: 6.8s; }
  @keyframes tagshow {
    0%, 4% { opacity: 0; transform: translateY(6px) scale(0.95); }
    12%, 76% { opacity: 1; transform: translateY(0) scale(1); }
    88%, 100% { opacity: 0; transform: translateY(-4px) scale(0.97); }
  }

  .scan-caption { font-size: 12.5px; color: var(--muted); margin-top: 14px; font-weight: 500; text-align: center; }
  .scan-caption strong { color: var(--text); }

  .scan-stats-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; max-width: 620px; margin: 26px auto 0; }
  .stat-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 16px 20px; box-shadow: var(--shadow-sm);
    display: flex; align-items: center; gap: 12px; flex: 1; min-width: 168px;
  }
  .ring-progress { flex-shrink: 0; }
  .ring-progress circle { transition: stroke-dashoffset 1.4s cubic-bezier(0.16,1,0.3,1); }
  .stat-num { font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 22px; color: var(--text); letter-spacing: -0.02em; }
  .stat-label { font-size: 11.5px; color: var(--muted); font-weight: 500; text-align: left; }

  /* ── SECTION SHARED ── */
  section { padding: 72px 40px; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--primary); margin-bottom: 12px; }
  .section-headline {
    font-family: 'Inter Tight', sans-serif;
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;
    color: var(--text); margin-bottom: 14px;
  }
  .section-sub { font-size: 16px; color: var(--muted); max-width: 560px; line-height: 1.7; }
  .section-header { margin-bottom: 44px; }
  .section-header.center { text-align: center; }
  .section-header.center .section-sub { margin: 0 auto; }

  /* ── SUB-PAGE HERO (About / Contact / Blog) ── */
  .page-hero { padding: 148px 40px 60px; text-align: center; }
  .page-hero .eyebrow { display: inline-flex; }
  .page-hero h1 {
    font-family: 'Inter Tight', sans-serif;
    font-size: clamp(30px, 4vw, 48px); font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--text); max-width: 720px; margin: 14px auto 16px;
  }
  .page-hero p { font-size: 16px; color: var(--muted); max-width: 560px; margin: 0 auto; line-height: 1.7; }

  /* ── CONTACT PAGE ── */
  .contact-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; max-width: 1000px; margin: 0 auto; align-items: start; }
  .contact-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); padding: 36px; }
  .form-field { margin-bottom: 18px; text-align: left; }
  .form-field label { display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .form-field input, .form-field textarea {
    width: 100%; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
    padding: 12px 14px; font-family: 'Inter', sans-serif; font-size: 14.5px; color: var(--text);
    background: var(--bg); transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-field input:focus, .form-field textarea:focus {
    outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(107,124,255,0.1);
  }
  .form-field textarea { resize: vertical; min-height: 120px; font-family: inherit; }
  .contact-submit { width: 100%; text-align: center; }
  .contact-info-item { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 24px; }
  .contact-info-icon {
    width: 40px; height: 40px; border-radius: 11px; background: rgba(107,124,255,0.1);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--primary);
  }
  .contact-info-item h4 { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
  .contact-info-item p, .contact-info-item a { font-size: 13.5px; color: var(--muted); text-decoration: none; line-height: 1.6; }
  .contact-info-item a:hover { color: var(--primary); }

  /* ── BLOG PAGE ── */
  .blog-notify-card { max-width: 560px; margin: 0 auto 56px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); padding: 32px; text-align: center; }
  .blog-notify-card .demo-input-row { text-align: left; }
  .blog-topics-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1100px; margin: 0 auto; }
  .blog-topic-card {
    background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 26px;
  }
  .blog-topic-tag {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--primary); background: rgba(107,124,255,0.08); border: 1px solid rgba(107,124,255,0.15);
    padding: 4px 10px; border-radius: 6px; margin-bottom: 14px;
  }
  .blog-topic-card h3 { font-family: 'Inter Tight', sans-serif; font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .blog-topic-card p { font-size: 13.5px; color: var(--muted); line-height: 1.6; }

  /* ── TRUST SECTION ── */
  .trust-section { background: var(--surface); padding: 56px 40px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1100px; margin: 0 auto; }
  .trust-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px; transition: all 0.25s cubic-bezier(0.16,1,0.3,1); }
  .trust-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: rgba(107,124,255,0.2); }
  .trust-icon { width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; font-size: 18px; }
  .trust-icon.purple { background: rgba(107,124,255,0.1); }
  .trust-icon.green { background: rgba(0,212,161,0.1); }
  .trust-icon.violet { background: rgba(139,92,246,0.1); }
  .trust-card h3 { font-family: 'Inter Tight', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 6px; color: var(--text); }
  .trust-card p { font-size: 13.5px; color: var(--muted); line-height: 1.6; }

  /* ── PROBLEM (merged shift + gap + threat) ── */
  .problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .shift-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--primary); background: rgba(107,124,255,0.08); border: 1px solid rgba(107,124,255,0.15); padding: 4px 10px; border-radius: 6px; margin: 6px 0 18px; }
  .mini-timeline { display: flex; flex-direction: column; gap: 14px; }
  .mini-timeline-item { display: flex; gap: 12px; }
  .mini-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); flex-shrink: 0; margin-top: 6px; }
  .mini-dot.now { background: var(--success); }
  .mini-dot.next { background: var(--primary); }
  .mini-timeline-item h4 { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .stat-pill-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
  .stat-pill { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 16px; flex: 1; min-width: 150px; }
  .stat-pill b { display: block; font-family: 'Inter Tight', sans-serif; font-size: 18px; font-weight: 800; color: var(--primary); }
  .stat-pill span { font-size: 11.5px; color: var(--muted); }

  .gap-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); box-shadow: var(--shadow); overflow: hidden; }
  .gap-box-head { padding: 18px 22px; border-bottom: 1px solid var(--border-light); font-size: 13px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .gap-item { border-bottom: 1px solid var(--border-light); }
  .gap-item:last-child { border-bottom: none; }
  .gap-q { display: flex; align-items: flex-start; gap: 12px; padding: 18px 22px; cursor: pointer; user-select: none; }
  .gap-num { font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 13px; color: var(--primary); flex-shrink: 0; margin-top: 1px; }
  .gap-q h3 { font-size: 14.5px; font-weight: 600; color: var(--text); line-height: 1.5; flex: 1; }
  .gap-chevron { flex-shrink: 0; color: var(--muted); transition: transform 0.25s; margin-top: 3px; }
  .gap-item.open .gap-chevron { transform: rotate(180deg); color: var(--primary); }
  .gap-a { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .gap-item.open .gap-a { max-height: 160px; }
  .gap-a p { font-size: 13px; color: var(--muted); line-height: 1.65; padding: 0 22px 20px 46px; }

  /* ── SOLUTION STEPPER ── */
  .stepper { position: relative; margin-top: 8px; }
  .stepper-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; position: relative; }
  .stepper-line { position: absolute; top: 27px; left: 6%; right: 6%; height: 2px; background: var(--border); }
  .stepper-line-fill { position: absolute; top: 0; left: 0; height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary), var(--secondary)); }
  .stepper-dot {
    position: absolute; top: 50%; left: 0%; width: 12px; height: 12px; border-radius: 50%;
    background: var(--secondary); box-shadow: 0 0 0 4px rgba(139,92,246,0.18), 0 0 10px rgba(139,92,246,0.6);
    transform: translate(-50%,-50%); transition: opacity 0.2s; opacity: 0;
  }
  .stepper-dot.on { opacity: 1; }
  .step { position: relative; text-align: left; }
  .step-num {
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 18px; color: var(--muted);
    margin-bottom: 18px; position: relative; z-index: 1;
    transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .step-num svg { width: 22px; height: 22px; }
  .step.active .step-num { border-color: var(--primary); color: var(--primary); background: #fff; box-shadow: 0 0 0 6px rgba(107,124,255,0.1); transform: scale(1.08); }
  .step h3 { font-family: 'Inter Tight', sans-serif; font-size: 16.5px; font-weight: 700; margin-bottom: 6px; color: var(--text); }
  .step p { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* ── LIVE DEMO ── */
  .demo-section { background: linear-gradient(160deg, #F8F9FF 0%, var(--bg) 100%); }
  .demo-card {
    max-width: 640px; margin: 0 auto;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg); padding: 36px;
  }
  .demo-input-row {
    display: flex; align-items: center; gap: 10px;
    background: var(--bg); border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 6px 6px 6px 16px; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .demo-input-row:focus-within { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(107,124,255,0.1); }
  .demo-input-icon { color: var(--muted); flex-shrink: 0; }
  .demo-input {
    flex: 1; border: none; background: transparent; font-family: 'Inter', sans-serif;
    font-size: 14.5px; color: var(--text); padding: 11px 0; min-width: 0;
  }
  .demo-input:focus { outline: none; }
  .demo-input::placeholder { color: #9CA3AF; }
  .demo-btn {
    flex-shrink: 0; font-size: 14px; font-weight: 600; color: #fff; border: none; cursor: pointer;
    border-radius: calc(var(--radius) - 4px);
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    padding: 12px 20px; box-shadow: 0 2px 10px rgba(107,124,255,0.3);
    transition: all 0.2s; white-space: nowrap;
  }
  .demo-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(107,124,255,0.4); }
  .demo-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin: 0 auto 10px; max-width: 520px; }
  .demo-stat { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 10px; }
  .demo-stat b { display: block; font-family: 'Inter Tight', sans-serif; font-size: 26px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }
  .demo-stat span { font-size: 11.5px; color: var(--muted); font-weight: 500; }
  .demo-stat.warn b { color: var(--warn); }
  .demo-stat.ok b { color: #059669; }
  .demo-result .demo-stats-note { font-size: 12px; margin: 0 auto 4px; }
  .demo-gate { margin: 22px auto 14px; padding-top: 22px; border-top: 1px solid var(--border-light); text-align: left; max-width: 520px; }
  .demo-gate h4 { font-family: 'Inter Tight', sans-serif; font-size: 16px; font-weight: 700; color: var(--text); text-align: center; margin-bottom: 6px; }
  .demo-gate p { text-align: center; margin: 0 auto 16px; }
  .demo-lead-done { text-align: center; }
  .demo-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
  .demo-field {
    width: 100%; font-family: 'Inter', sans-serif; font-size: 14.5px; color: var(--text);
    border: 1.5px solid var(--border); border-radius: calc(var(--radius) - 4px);
    padding: 12px 14px; background: var(--bg); min-width: 0;
  }
  .demo-field:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(107,124,255,0.1); }
  .demo-field::placeholder { color: #9CA3AF; }
  .demo-field-wide { grid-column: 1 / -1; }
  .demo-consent { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; font-size: 12.5px; color: var(--muted); line-height: 1.5; cursor: pointer; }
  .demo-consent input { margin-top: 3px; flex-shrink: 0; accent-color: var(--primary); }
  .demo-submit { width: 100%; margin-top: 16px; padding: 14px 20px; }
  .demo-hint { font-size: 12px; color: var(--muted); text-align: center; margin-top: 14px; }

  .demo-scanning { text-align: center; padding: 12px 0 4px; }
  .demo-scan-ring { position: relative; width: 92px; height: 92px; margin: 0 auto 18px; }
  .demo-scan-core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 6px rgba(107,124,255,0.1);
  }
  .demo-scan-core svg { width: 20px; height: 20px; }
  .demo-progress { height: 10px; max-width: 360px; margin: 14px auto 6px; border-radius: 100px; background: var(--border-light); border: 1px solid var(--border); overflow: hidden; }
  .demo-progress-fill {
    position: relative; height: 100%; width: 0%; border-radius: 100px; overflow: hidden;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
