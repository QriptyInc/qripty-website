---
import QuantumScan from './QuantumScan.astro';
---
<!-- HERO -->
<div class="hero">
  <div class="hero-copy">
    <div class="hero-badge">Quantum Readiness Platform for Fintech APIs</div>
    <h1>Your APIs are secure today.<br><em>Will they stay that way?</em></h1>
    <p class="hero-sub">Quantum computers will eventually break the encryption protecting today's API traffic. Qripty discovers your cryptographic exposure, builds a live inventory, and deploys quantum-ready protection — without touching application code or moving data outside your infrastructure.</p>
    <div class="hero-ctas">
      <a href="#" class="btn-hero-primary">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Get Risk Assessment
      </a>
      <a href="#" class="btn-hero-secondary">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M15 10l4.553-2.069A1 1 0 0121 8.87V15.13a1 1 0 01-1.447.9L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/></svg>
        Book Technical Demo
      </a>
    </div>
    <div class="hero-trust">
      <span>No code changes</span>
      <span>Deploy in hours</span>
      <span>Your data never leaves your infrastructure</span>
    </div>
  </div>

  <QuantumScan />
</div>
