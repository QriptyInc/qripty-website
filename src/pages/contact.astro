---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact — Qripty" description="Get in touch with the Qripty team about your API estate, a demo, or anything else.">
  <Nav />

  <div class="page-hero">
    <div class="eyebrow">Get in Touch</div>
    <h1>Let's talk about your API estate.</h1>
    <p>Whether you want a walkthrough, have a question about compliance frameworks, or just want to know where to start — send us a note.</p>
  </div>

  <section>
    <div class="section-inner">
      <div class="contact-grid">
        <div class="contact-card reveal">
          <form id="contactForm" data-success="Thanks — we've received your message and will get back to you within one business day.">
            <div class="form-field">
              <label for="contactName">Name</label>
              <input type="text" id="contactName" name="name" placeholder="Jane Doe" required />
            </div>
            <div class="form-field">
              <label for="contactEmail">Work email</label>
              <input type="email" id="contactEmail" name="email" placeholder="you@company.com" required />
            </div>
            <div class="form-field">
              <label for="contactCompany">Company</label>
              <input type="text" id="contactCompany" name="company" placeholder="Your company" />
            </div>
            <div class="form-field">
              <label for="contactMessage">Message</label>
              <textarea id="contactMessage" name="message" placeholder="Tell us a bit about what you're looking for…" required></textarea>
            </div>
            <button type="submit" class="demo-btn contact-submit"><span>Send Message</span></button>
          </form>
        </div>

        <div class="reveal">
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h4>General inquiries</h4>
              <a href="mailto:hello@qripty.io">hello@qripty.io</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h4>Sales &amp; demos</h4>
              <a href="mailto:sales@qripty.io">sales@qripty.io</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg>
            </div>
            <div>
              <h4>Security &amp; compliance</h4>
              <a href="mailto:security@qripty.io">security@qripty.io</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h4>Response time</h4>
              <p>Within one business day, usually sooner.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
